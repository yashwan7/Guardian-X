{
  "name": "secure-ota-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Firmware Lifecycle & Fleet Resilience Platform",
  "workspaces": [
    "frontend",
    "device-simulator",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:simulator": "npm --workspace=device-simulator run dev",
    "nxp:bridge": "node scripts/nxp_bridge.js",
    "nxp:sim": "./nxp-firmware/nxp_demo_sim",
    "nxp:flash": "bash scripts/flash_nxp.sh",
    "dev": "npm --workspace=frontend run dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
