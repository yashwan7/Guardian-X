# ==================================================
# SECURE OTA GUARDIAN — Environment Variables
# ==================================================
# Copy this file to .env.local (frontend) and configure backend env vars.
# NEVER commit actual secrets to source control.

# ==================================================
# FRONTEND (frontend/.env.local)
# ==================================================

# Supabase — get from https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ==================================================
# BACKEND (backend/src/main/resources/application-local.yml)
# ==================================================

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/guardian
DATABASE_USERNAME=guardian
DATABASE_PASSWORD=guardian_secret

# Supabase JWT Secret — get from Supabase → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==================================================
# DEVICE SIMULATOR (device-simulator/.env)
# ==================================================

BACKEND_URL=http://localhost:8080
DEVICE_ID=NXP-001
SIMULATOR_INTERVAL_MS=2000
